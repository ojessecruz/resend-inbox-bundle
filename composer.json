{
    "name": "ojessecruz/resend-inbox-bundle",
    "description": "A shared email inbox for Symfony apps, powered by Resend inbound email",
    "keywords": ["symfony", "bundle", "resend", "inbox", "email", "inbound", "helpdesk"],
    "homepage": "https://github.com/ojessecruz/resend-inbox-bundle",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Jessé Cruz",
            "email": "cruzkta@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/doctrine-bundle": "^2.13||^3.0",
        "doctrine/orm": "^3.4",
        "ojessecruz/resend-inbox": "^0.1",
        "psr/log": "^3.0",
        "symfony/asset": "^7.4||^8.0",
        "symfony/form": "^7.4||^8.0",
        "symfony/framework-bundle": "^7.4||^8.0",
        "symfony/messenger": "^7.4||^8.0",
        "symfony/security-bundle": "^7.4||^8.0",
        "symfony/security-csrf": "^7.4||^8.0",
        "symfony/translation": "^7.4||^8.0",
        "symfony/twig-bundle": "^7.4||^8.0",
        "symfony/validator": "^7.4||^8.0",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "symfony/browser-kit": "^7.4||^8.0",
        "symfony/css-selector": "^7.4||^8.0",
        "symfony/dom-crawler": "^7.4||^8.0"
    },
    "autoload": {
        "psr-4": {
            "Jessecruz\\ResendInboxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jessecruz\\ResendInboxBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
