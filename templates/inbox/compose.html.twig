{% extends '@ResendInbox/layout.html.twig' %}

{% block resend_inbox_title %}{{ 'titles.compose'|trans({}, 'resend_inbox') }}{% endblock %}

{% block resend_inbox_content %}
<div class="inbox inbox--compose">
    <a class="inbox-back" href="{{ path('resend_inbox_index') }}">&larr; {{ 'titles.inbox'|trans({}, 'resend_inbox') }}</a>

    {{ include('@ResendInbox/partials/_heading.html.twig', {title: 'titles.compose'|trans({}, 'resend_inbox')}) }}

    {{ include('@ResendInbox/partials/_email_form.html.twig', {form: form, submit_label: 'actions.send'|trans({}, 'resend_inbox')}) }}
</div>
{% endblock %}
